/* ─── Types ──────────────────────────────────────────────── */
type View = "overview" | "navigator" | "trend";

interface Component {
  id: string;
  name: string;
  weight: number;
  earned: number | null;
  total: number;
}

interface Course {
  id: string;
  code: string;
  name: string;
  professor: string;
  credits: number;
  dropLowest: boolean;
  components: Component[];
  parsedFromSyllabus?: boolean;
}

